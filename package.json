{
  "name": "messaging",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "bun -e \"import { rmSync } from 'node:fs'; rmSync('.next/types', { recursive: true, force: true });\" && tsc --noEmit",
